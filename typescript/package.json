{
  "name": "@thumbrella/client",
  "version": "1.0.3",
  "description": "TypeScript client for the Thumbrella thumbnail API - typed results, streaming batches, pluggable caching",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "dist/element.js",
  "jsdelivr": "element.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "element.js",
    "browser.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:bundle",
    "build:bundle": "npx tsx scripts/bundle.ts",
    "bench": "npx tsx scripts/bench.ts"
  },
  "keywords": [
    "thumbrella",
    "thumbnail",
    "image",
    "media",
    "streaming",
    "thumbnails"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thumbrella-dev/clients.git",
    "directory": "typescript"
  },
  "homepage": "https://thumbrella.dev",
  "docs": "https://thumbrella.dev/docs/client",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3"
  }
}
