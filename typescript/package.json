{
  "name": "@thumbrella/client",
  "version": "1.4.2",
  "description": "TypeScript client for the Thumbrella thumbnail API - typed results, streaming batches, pluggable caching",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bench": "npx tsx scripts/bench.ts"
  },
  "keywords": [
    "thumbrella",
    "thumbnail",
    "image",
    "media",
    "tbr-thumb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thumbrella-dev/clients.git",
    "directory": "typescript"
  },
  "homepage": "https://thumbrella.dev",
  "docs": "https://thumbrella.dev/docs/client",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.1",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
